{
  "name": "leidong-model-config",
  "displayName": "雷动BYOK",
  "description": "为 Copilot Chat 提供 DeepSeek / MiMo 自定义模型端点（BYOK）：可视化模型管理、自定义模型名称、API Key 安全存储。",
  "version": "0.1.3",
  "publisher": "KuCai",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lsrweb/leidong-tools.git",
    "directory": "extensions/model-config"
  },
  "bugs": {
    "url": "https://github.com/lsrweb/leidong-tools/issues"
  },
  "homepage": "https://github.com/lsrweb/leidong-tools#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "deepseek",
    "mimo",
    "copilot",
    "byok",
    "模型配置",
    "自定义端点"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "leidong-tools",
        "displayName": "自定义模型"
      }
    ],
    "commands": [
      {
        "command": "leidong-models.openModelPanel",
        "title": "配置自定义模型",
        "category": "雷动BYOK"
      },
      {
        "command": "leidong-models.setApiKey",
        "title": "设置模型 API Key",
        "category": "雷动BYOK"
      },
      {
        "command": "leidong-models.setVisionModel",
        "title": "配置视觉代理",
        "category": "雷动BYOK"
      },
      {
        "command": "leidong-models.showLogs",
        "title": "显示模型日志",
        "category": "雷动BYOK"
      },
      {
        "command": "leidong-models.openSettings",
        "title": "打开模型设置",
        "category": "雷动BYOK"
      }
    ],
    "configuration": {
      "title": "雷动BYOK",
      "properties": {
        "leidong-models.models": {
          "type": "array",
          "description": "自定义模型列表。每个模型对应一个 OpenAI 兼容端点；name 为模型选择器中显示的名称。修改请同步 extensions/model-config/src/models.ts 的 DEFAULT_MODELS。",
          "default": [
            {
              "id": "deepseek-v4-flash",
              "name": "DeepSeek V4 Flash",
              "family": "deepseek",
              "version": "v4",
              "baseUrl": "https://api.deepseek.com",
              "maxInputTokens": 655360,
              "maxOutputTokens": 393216,
              "capabilities": {
                "toolCalling": 128,
                "imageInput": true,
                "thinking": true
              },
              "thinkingEffort": "high",
              "pricing": {
                "USD": {
                  "cacheHitInput": 0.0028,
                  "cacheMissInput": 0.14,
                  "output": 0.28
                },
                "CNY": {
                  "cacheHitInput": 0.02,
                  "cacheMissInput": 1,
                  "output": 2
                }
              },
              "priceCategory": "low"
            },
            {
              "id": "deepseek-v4-pro",
              "name": "DeepSeek V4 Pro",
              "family": "deepseek",
              "version": "v4",
              "baseUrl": "https://api.deepseek.com",
              "maxInputTokens": 655360,
              "maxOutputTokens": 393216,
              "capabilities": {
                "toolCalling": 128,
                "imageInput": true,
                "thinking": true
              },
              "thinkingEffort": "high",
              "pricing": {
                "USD": {
                  "cacheHitInput": 0.003625,
                  "cacheMissInput": 0.435,
                  "output": 0.87
                },
                "CNY": {
                  "cacheHitInput": 0.025,
                  "cacheMissInput": 3,
                  "output": 6
                }
              },
              "priceCategory": "low"
            },
            {
              "id": "mimo-v2.5-pro",
              "name": "MiMo V2.5 Pro",
              "family": "mimo",
              "version": "v2.5",
              "baseUrl": "https://token-plan-cn.xiaomimimo.com/v1",
              "maxInputTokens": 1048576,
              "maxOutputTokens": 65536,
              "capabilities": {
                "toolCalling": true,
                "imageInput": true,
                "thinking": true
              },
              "thinkingEffort": "high",
              "pricing": {
                "USD": {
                  "cacheHitInput": 0.003625,
                  "cacheMissInput": 0.435,
                  "output": 0.87
                },
                "CNY": {
                  "cacheHitInput": 0.025,
                  "cacheMissInput": 3,
                  "output": 6
                }
              },
              "priceCategory": "low"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "baseUrl"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "description": "唯一标识，也是 VS Code 模型 ID。"
              },
              "name": {
                "type": "string",
                "description": "模型选择器中显示的名称，可自由自定义。"
              },
              "family": {
                "type": "string",
                "default": "deepseek",
                "description": "平台标签（deepseek / mimo / openai / qwen 等任意值）：决定思考强度预设与请求参数语义；未知平台按标准 OpenAI 兼容处理。"
              },
              "version": {
                "type": "string"
              },
              "detail": {
                "type": "string",
                "description": "模型选择器中的副标题。"
              },
              "baseUrl": {
                "type": "string",
                "description": "模型服务端点基础地址。"
              },
              "apiType": {
                "type": "string",
                "enum": [
                  "chat-completions",
                  "responses",
                  "anthropic-messages"
                ],
                "default": "chat-completions",
                "description": "接口类型：OpenAI 兼容 Chat Completions（默认，兼容性最好）、OpenAI 兼容 Responses、Anthropic 兼容 Messages。"
              },
              "apiModelId": {
                "type": "string",
                "description": "发送给端点的实际模型 ID；留空则使用 id。"
              },
              "maxInputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "maxOutputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "maxTokens": {
                "type": "integer",
                "minimum": 0,
                "description": "单次请求最大输出 token；0 表示由 API 决定。"
              },
              "capabilities": {
                "type": "object",
                "properties": {
                  "toolCalling": {
                    "type": [
                      "boolean",
                      "integer"
                    ],
                    "default": true
                  },
                  "imageInput": {
                    "type": "boolean",
                    "default": false
                  },
                  "thinking": {
                    "type": "boolean",
                    "default": true
                  }
                }
              },
              "thinkingEffort": {
                "type": "string",
                "enum": [
                  "none",
                  "low",
                  "medium",
                  "high"
                ],
                "description": "默认思考强度。"
              },
              "pricing": {
                "type": "object",
                "description": "每百万 token 价格（USD / CNY），用于模型选择器的费用提示。"
              },
              "priceCategory": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "very_high"
                ]
              }
            }
          }
        },
        "leidong-models.visionModel": {
          "type": "string",
          "default": "",
          "description": "视觉代理使用的 VS Code 模型 key。"
        },
        "leidong-models.visionPrompt": {
          "type": "string",
          "default": "You are a vision-to-text bridge for a language-only model. Describe the image in detail so the reader can answer questions about it. Respond with the description only.",
          "description": "视觉代理将图片转换为文字描述时使用的提示词。"
        },
        "leidong-models.debugMode": {
          "type": "string",
          "default": "minimal",
          "enum": [
            "minimal",
            "metadata",
            "verbose"
          ],
          "enumDescriptions": [
            "仅记录关键事件。",
            "记录请求/响应元数据（不含内容）。",
            "记录全部请求/响应内容并支持转储请求体到磁盘。"
          ],
          "description": "日志详细程度。verbose 还会启用请求体转储。"
        },
        "leidong-models.debug": {
          "type": "boolean",
          "default": false,
          "deprecationMessage": "已废弃，请改用 debugMode。",
          "description": "遗留开关：true 等价于 debugMode=metadata。"
        },
        "leidong-models.experimental.stabilizeToolList": {
          "type": "boolean",
          "default": false,
          "description": "实验性：稳定工具列表，减少工具漂移。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "vsix": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.108.0",
    "@vscode/vsce": "^3.9.2",
    "ts-loader": "^9.6.2",
    "typescript": "^5.8.2",
    "webpack": "^5.108.4",
    "webpack-cli": "^6.0.1"
  }
}

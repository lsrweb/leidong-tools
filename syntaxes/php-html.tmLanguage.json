{
    "fileTypes": [],
    "scopeName": "inline.php-html",
    "injectionSelector": "L:text.html.basic -comment -source.js -source.css",
    "unbalancedBracketScopes": [
        "meta.embedded.block.php.html",
        "punctuation.section.embedded.begin.php",
        "punctuation.section.embedded.end.php"
    ],
    "patterns": [
        {
            "name": "meta.embedded.block.php.html",
            "contentName": "source.php",
            "begin": "(?i)(<\\?)(php\\b|=|(?=\\s))",
            "beginCaptures": {
                "1": { "name": "punctuation.section.embedded.begin.php" },
                "2": { "name": "punctuation.section.embedded.begin.php" }
            },
            "end": "(\\?>)",
            "endCaptures": {
                "1": { "name": "punctuation.section.embedded.end.php" }
            },
            "patterns": [
                { "include": "source.php" }
            ]
        }
    ]
}
